{
  "mcpServers": {
    "nougen-shards": {
      "command": "python",
      "args": ["-m", "nougen_shards.mcp"],
      "env": {
        "PYTHONPATH": "src",
        "PYTHONIOENCODING": "utf-8",
        "NOUGEN_VAULT_DIR": "~/.nougen/shards",
        "NOUGEN_RECALL_TOKEN_BUDGET": "8000",
        "NOUGEN_RECALL_DEADLINE_S": "15",
        "NOUGEN_VECTOR_CACHE_WAIT_S": "1",
        "NOUGEN_SQLITE_TIMEOUT_S": "30"
      }
    },
    "ollama": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "ollama-mcp"],
      "env": {
        "OLLAMA_HOST": "http://127.0.0.1:11434"
      }
    },
    "sequentialthinking": {
      "type": "http",
      "url": "https://remote.mcpservers.org/sequentialthinking/mcp"
    },
    "Ref": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "REF_API_KEY", "mcp/ref-tools-mcp"],
      "env": {
        "REF_API_KEY": "${REF_API_KEY}"
      }
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "Accept": "application/json",
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    },
    "nougen-ctx": {
      "command": "npx",
      "args": [
        "-y",
        "context-mode"
      ]
    }
  }
}
