# NouGenShards Environment Template
# Copy this to .env and fill in your keys.
# NEVER commit your .env file to source control.

# --- Who Visions Cloud (Pro) ---
# Your NGS Cloud Gateway URL (e.g., your HF Space URL)
NGS_CLOUD_URL=https://your-node.hf.space
# Your Who Visions Pro user token
NGS_CLOUD_TOKEN=your_pro_token_here

# --- BYOK (Bring Your Own Key) ---
# Optional: You can also set these via 'nougen auth set-key <provider> <key>'
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
HUGGINGFACE_API_KEY=hf_...
OPENROUTER_API_KEY=sk-or-...

# --- Node Configuration (Server-Side) ---
# If you are running your own node, set the required write-auth token here
NGS_NODE_TOKEN=your_private_node_token

# Cortex HUD login (the vault UI served at "/"). On a network-exposed deploy
# (a Space, or NGS_HOST=0.0.0.0) the HUD is fail-closed: it is NOT mounted
# unless BOTH of these are set. The token-gated /mcp endpoint and REST API stay
# up regardless. Leave unset to withhold the unauthenticated HUD; set both to
# serve it with basic-auth. Loopback binds (127.0.0.1) mount it without a login.
NGS_HUD_USER=
NGS_HUD_PASSWORD=

# --- nougen-fleet-registry MCP server -------------------------------------
# Primary shard vault (defaults to the repo-local .vault).
# NOUGEN_VAULT_DIR=.vault
# Extra read-only vaults to federate over, os.pathsep-separated, "label=path" ok.
# NOUGEN_SECONDARY_VAULT_DIRS=
# Optional private extension adding operator-specific tools. File path or module.
# Must expose register(mcp); may expose CLAIMS=[...] to own a product tool name.
# Absent or broken = logged to stderr, product tools still serve.
# NOUGEN_REGISTRY_EXT=
# Result-limit knobs (defaults 10 / 100 / 2000).
# NOUGEN_REGISTRY_DEFAULT_LIMIT=
# NOUGEN_REGISTRY_MAX_LIMIT=
# NOUGEN_REGISTRY_RECENT_SCAN_CAP=
