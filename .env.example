# ==============================================================================
# 🛰️ NouGen Canonical Environment Configuration Template (.env.example)
#
# Copy this file to .env and customize values for your deployment.
# All values are optional; NouGen automatically defaults to $0 local-first
# execution using Ollama and local SQLite storage in ~/.nougen.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Node Identity & Storage
# ------------------------------------------------------------------------------
# Root storage directory for the 9-DB memory grid and encrypted vault
# Defaults to ~/.nougen/shards if unset
NOUGEN_VAULT_DIR=~/.nougen/shards

# Active Node Name / Stadium identifier (e.g., hyperion, apollo, phoebus, cloud)
NOUGEN_NODE_NAME=local-node

# ------------------------------------------------------------------------------
# 2. Local AI Inference ($0 Local First)
# ------------------------------------------------------------------------------
# Local Ollama / LM Studio OpenAI-compatible endpoint
NOUGEN_OLLAMA_URL=http://127.0.0.1:11434/v1

# Preferred local resident model (e.g. gemma4:e2b-qat, gemma2:9b, qwen2.5:7b)
NOUGEN_RHEA_LOCAL_MODEL=gemma4:e2b-qat

# ------------------------------------------------------------------------------
# 3. Cloud Inference & Fallback ($0 Free & Frontier Routes)
# ------------------------------------------------------------------------------
# OpenRouter API Key (Optional — enables 7-model rollover across free cloud models)
OPENROUTER_API_KEY=

# Hugging Face Token (Optional — enables Kimi K3 and serverless inference)
HF_TOKEN=

# Hugging Face Space / Inference Router Model (Default: moonshotai/Kimi-K3)
NOUGEN_RHEA_MODEL=moonshotai/Kimi-K3

# Ollama Cloud API Key (Optional — for cloud-hosted 120B+ models)
NOUGEN_OLLAMA_CLOUD_KEY=

# ------------------------------------------------------------------------------
# 4. Networking, Fleet Mesh & MCP Gateway
# ------------------------------------------------------------------------------
# Port for the FastMCP / FastAPI node server (Default: 8000)
NOUGEN_PORT=8000

# Canonical Public Shards Gateway URL
SHARD_GATEWAY_URL=https://shards.nougenai.com/mcp

# Pre-shared Node Authentication Token for Mesh Federation
NGS_NODE_TOKEN=
