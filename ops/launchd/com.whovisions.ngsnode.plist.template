<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whovisions.ngsnode</string>

    <!-- Single entry point: the launcher loads .env, so a manual run and a
         launchd run get identical config. -->
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/bin/ngs-node.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- Restart on crash, but NOT on a clean exit 0, so a deliberate
             `launchctl kickstart -k` stop stays stopped. -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- A missing token exits 78 immediately; without throttling launchd would
         respawn that in a tight loop and fill the log. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/ngs-node.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/ngs-node.err.log</string>

    <!-- Descriptor headroom. launchd's default soft limit is 256 open files;
         one recall opens ~40 and six concurrent fan-outs hit the ceiling
         exactly (phoebus, 2026-09-04: every open() then failed, the vector
         cache rebuilt per request, the local lane missed every deadline).
         app.py also raises its own soft limit at startup (fd_budget.py); this
         is the belt to that brace, and covers the launcher shell too. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>

    <!-- Background service: keeps the node off the interactive scheduler band
         and exempt from App Nap. -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
