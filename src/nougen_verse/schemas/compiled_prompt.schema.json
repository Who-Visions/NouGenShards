{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nougen.local/schemas/compiled_prompt.schema.json",
  "title": "CompiledPrompt",
  "type": "object",
  "required": ["schema_version", "provider", "format", "system", "user", "messages", "constraint_packet", "output_schema", "generation_sequence", "self_check", "revision_loop", "notes"],
  "properties": {
    "schema_version": {"type": "string"},
    "provider": {"type": "string"},
    "format": {"enum": ["text", "messages", "json"]},
    "system": {"type": "string"},
    "user": {"type": "string"},
    "messages": {"type": "array", "items": {"type": "object", "required": ["role", "content"]}},
    "constraint_packet": {"type": "object", "required": [
      "persona_contract", "content_spine", "bar_objectives", "rhyme_families", "beat_grid", "breath_constraints",
      "required_facts", "forbidden_cliches", "flow_switch_rationale"
    ]},
    "output_schema": {"type": "object", "required": ["type", "required", "properties"]},
    "generation_sequence": {"type": "array", "minItems": 12, "items": {"type": "string"}},
    "self_check": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "revision_loop": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
