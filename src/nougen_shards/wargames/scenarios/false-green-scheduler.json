  "level": "duel",
  "mode": "false_green",
  "version": 1,
  "mission": {
    "goal": "Detect silent scheduled task expiration",
    "destiny": "Continuous fleet automation remains truthful"
  },
  "arena": {"repos": ["NouGenShards"], "nodes": ["blade"]},
  "initial_state": {
    "task": {
      "name": "shard_integrity_sweep",
