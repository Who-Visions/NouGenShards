  "turns": 5,
  "fog": {"blue": {"inject_visibility": "hidden"}, "white": {"ground_truth": "full"}},
  "elevation": {
    "failure_class": "false_green",
    "description": "repeating task had no future run while history looked healthy",
    "assumption": "last_success_implies_future_health",
    "invariant": "repeating_task_must_have_future_run",
    "component": "task_truth",
    "change_type": "deterministic_checker"
