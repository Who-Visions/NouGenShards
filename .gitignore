# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Databases (-wal/-shm are sidecars that `*.db` does not match)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Local configuration
mcp.config.json
.env
# `.env` does not match dotted-prefix variants like `.nougen.local.env`.
*.local.env
.nougen-hooks/
.claude/
secrets/
.mcp-locks/

# Keymaker vault (DPAPI-encrypted, user-bound — never ship). Covers the CSV
# ledger and service_accounts/ JSON that *.db alone would miss.
.nougen_vault/
*_secrets.csv
*_secrets.db
service_accounts/

# Fleet test reports / ad-hoc audit output
tools/reports/
ts/audit_results.json
audit-runs/
drill-runs/
drills/

# Virtual environments & session logs
.venv/
venv/
transcript.log
# .handoffs/ is the relay registry, and records ARE the payload — a registry
# nobody else can read is not a registry. Ignored here since June, which is why
# 130+ legs written in this repo never reached another machine.
# The pre-relay records keep their old naming and stay local; anything written
# by `relay` (<UTC>__<machine>__<agent>) is shared.
.handoffs/handoff_*
.handoffs/gemini handoffs/
# `.handoffs/handoff_*` only anchors at the top level, so the pre-relay per-agent
# subdirectories were untracked-but-not-ignored: one `git add -A` would have
# published spend figures, incident notes and machine paths to a public remote.
.handoffs/**/handoff_*
.handoffs/*handoffs/
.handoffs/.sessions/
.handoffs/queue/
.handoffs/_*.md
.handoffs/audit_*
.handoffs/fleet_audit_*.md
.handoffs/*-note.md
.handoffs/tauri-ipc-sprint-note.md
.handoffs_msg_*.md
.vault/
pending_shards/

# Node dependencies
node_modules/
package-lock.json

# Development tools
.pytest_cache/
.benchmarks/
.agents/

# Build artifacts
dist/
build/
*.egg-info/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/
src-tauri/bin/*.exe
src-tauri/bin/build/
src-tauri/bin/dist/
# Binary icon formats are regenerated locally via `tauri icon` (HF rejects them)
src-tauri/icons/*.ico
src-tauri/icons/*.icns
src-tauri/icons/android/
src-tauri/icons/ios/

