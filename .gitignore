migrate_vault.py
migrate_vault_v2.py
incremental_migration.py
incremental_migration_v2.py
migrate_memories.py
verify_swap.py
fix_types.py
check_unsharded.py
shard_vault_files.py
tools/migrate_prototype_persistence.py

# Fleet / orchestration tooling — internal, not part of the public package
# (banned from the user-facing tree by the project constitution).
tools/fleet_test.py
tools/nougenai_fleet_registry_mcp.py

# OS specific
Thumbs.db
.DS_Store

# Private agent operating docs — local-only, never shipped.
# These encode the maintainer's own agent roles, machine paths, fleet inventory
# and routing/cost policy. They are load-bearing for local development but have
# no value to anyone installing this package, so they stay on disk and out of
# the repo. (Note: brain_scan treats "CLAUDE.md"/"GEMINI.md" as generic project
# filenames it may scan in a *user's* project — that is unrelated to these.)
/CLAUDE.md
/GEMINI.md
/AGENTS.md
# Campaign retrospective — narrates real token volumes and dollar figures for the
# maintainer's own accounts. Same reason as above: load-bearing locally, ops data
# to a stranger.
docs/valerion-orchestration-playbook.md

# Internal ops surface -- never ships to the public repo (origin: GitHub,
# hf: HuggingFace Space). War-games carry cost/billing analysis and unresolved
# GM decisions; transcripts and dreams are working notes, not product.
wargames/
transcripts/
dreams/
*.blade-local-*
fleet_keys_valid.json
tools/fleet_keys_valid.json
hf_router_models.json

# Local-only: personal canon/provenance. This repo is PUBLIC - never publish these.
canon/

# Node runtime state and the vendored cloudflared binary (52 MB)
.node/
tools/bin/

