dump_vault.py
dump_elevated.py
dump_memories_schema.py
get_memories_schema.py
list_tables.py
list_backup_tables.py
tmp_dump.py
tmp_dump_global.py
tools/read_vault_shards.py
load_secrets.py
count_shards.py
dream_all.py
fast_ingest.py

# One-time / version-numbered migration scripts — history belongs in git, not
# in filenames. Local-only.
migrate_vault.py
migrate_vault_v2.py
incremental_migration.py
incremental_migration_v2.py
migrate_memories.py
verify_swap.py
fix_types.py
check_unsharded.py
shard_vault_files.py

# Fleet / orchestration tooling — internal, not part of the public package
# (banned from the user-facing tree by the project constitution).
tools/fleet_test.py
tools/nougenai_fleet_registry_mcp.py

# OS specific
Thumbs.db
.DS_Store
*.nougen-bak

# ---------------------------------------------------------------------------
# Internal operator surface — kept on disk, never shipped to the public repo.
# These drive the maintainer's local agent workflow (hooks, doctrine, missions)
# and have zero value to someone who clones NouGenShards. Untracked via
# `git rm --cached`, so every local tool keeps reading them exactly as before.
# ---------------------------------------------------------------------------

# Private chain of command / agent doctrine
CLAUDE.md
GEMINI.md
AGENTS.md
HARDENING.md

# Separate private project — not part of NouGenShards
SOL_AI_PROVENANCE.md

# Internal orchestration playbook + session transcripts
docs/valerion-orchestration-playbook.md
docs/handoffs/

# Internal ops: war-games, drills, incident log
wargames/
drills/

# Local agent harness config (settings.json + settings.local.json)
.claude/

# Owner-workflow tools that read a Memory Vault strangers do not have
tools/arxiv_*.py
tools/atomize_*.py
tools/capture_doctrine*.py
tools/dream_deep*.py
tools/valerion_*.py
tools/migrate_watchtower_memory*.py
tools/replay_session_*.sh

# Repo-guard private config. The identity list names exactly the personal data
# the guard searches for - committing it would leak what it protects.
# Canonical copy lives OUTSIDE this repo (../repo-guard/config/).
identity.local.json
*.local.json
repo-guard/
.repoguard/
transcripts/

# Local measurement/run artifacts: these capture private vault contents and
# agent performance runs. Not part of the shipped product.
audit-runs/
drill-runs/
.handoffs_msg_*.md

# SQLite journal sidecars - transient, and can contain vault data.
shards.db-wal
shards.db-shm
*.db-wal
*.db-shm

# Local-only guard helper: contains absolute private workspace paths.
tools/scan_guard.py

# Mutation-testing backups and coverage artifacts — never ship.
*.mutbak
*.secmutbak
.coverage
