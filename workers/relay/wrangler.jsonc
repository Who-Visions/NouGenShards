{
  // NouGen Relay. Free plan: Workers + SQLite-backed Durable Objects + KV only.
  // Default (top-level) config is the PREVIEW deployment on workers.dev; nodes are
  // reached as https://<worker>.workers.dev/n/<id>/. Production routes are not set
  // here on purpose: taking over <id>.nougenai.com is a GM decision (env "production").
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nougen-relay-preview",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "RelaySession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelaySession"] }],
  // Fill with `wrangler kv namespace create RELAY_AUTH` output before deploying.
  "kv_namespaces": [{ "binding": "RELAY_AUTH", "id": "REPLACE_WITH_KV_ID" }],
  "vars": { "RELAY_HOST_SUFFIX": "", "RELAY_REQUEST_TIMEOUT_MS": "30000", "RELAY_MAX_BODY_BYTES": "8388608" },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "nougen-relay",
      "workers_dev": false,
      "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "RelaySession" }] },
      "kv_namespaces": [{ "binding": "RELAY_AUTH", "id": "REPLACE_WITH_KV_ID" }],
      "vars": { "RELAY_HOST_SUFFIX": ".nougenai.com", "RELAY_REQUEST_TIMEOUT_MS": "30000", "RELAY_MAX_BODY_BYTES": "8388608" },
      "routes": []
    }
  }
}
