{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Who-Visions/NouGenShards/main/schemas/readme-manifest.schema.json",
  "title": "NouGen Structured README Manifest",
  "type": "object",
  "required": ["project", "sections"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "project": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "emoji": {"type": "string", "maxLength": 32}
      },
      "additionalProperties": false
    },
    "table_of_contents": {"type": "boolean", "default": true},
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "image"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "image": {"type": "string", "minLength": 1},
          "url": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "content": {"type": "string"},
          "file": {"type": "string", "minLength": 1},
          "emoji": {
            "anyOf": [
              {"enum": ["auto", "none"]},
              {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "\\S"}
            ]
          },
          "keywords": {"type": "array", "items": {"type": "string"}}
        },
        "oneOf": [
          {"required": ["content"], "not": {"required": ["file"]}},
          {"required": ["file"], "not": {"required": ["content"]}}
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "persona": {
      "type": "object",
      "properties": {
        "market": {"type": "string"},
        "audience": {"type": "string"},
        "register": {"type": "string"},
        "fingerprint": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
