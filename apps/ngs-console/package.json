{
  "name": "ngs-console",
  "version": "0.1.0",
  "private": true,
  "description": "NGS console: a shadcn/ui agent interface over the NouGenShards native engine (engine/ngs).",
  "scripts": {
    "engine": "make -C ../../engine/ngs lib cli",
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types lib/*.test.ts"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9"
  }
}
